{
  "name": "pos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Point of Sale System for Automotive Dealerships & Parts Retailers",
  "scripts": {
    "build": "npm run build:web && nest build",
    "build:web": "node scripts/build-web.cjs",
    "start": "npm run build:web && nest start",
    "start:dev": "npm run build:web && nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/config": "^3",
    "@nestjs/typeorm": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/passport": "^10",
    "typeorm": "^0.3",
    "mysql2": "^3",
    "bcryptjs": "^3",
    "class-validator": "^0.14",
    "class-transformer": "^0.5",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "typescript": "~5.6",
    "ts-node": "^10",
    "@types/node": "^22",
    "@types/passport-jwt": "^4",
    "esbuild": "^0.25"
  }
}
